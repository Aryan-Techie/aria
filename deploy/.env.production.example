# Production environment for the Oracle box. Copy to deploy/.env.production
# and fill in. That file is gitignored and must never be committed.
#
#   cp deploy/.env.production.example deploy/.env.production
#
# Everything the local backend/.env holds is still needed here - this file is
# the deployment's single .env, read by both the backend container and the
# compose file itself.

# ---------------------------------------------------------------- addresses
# The two hostnames you pointed at this server with A records. No https://,
# no trailing slash - Caddy takes the bare hostname and the compose file
# builds the URLs from it.
ARIA_DOMAIN=aria.aroice.in
ARIA_CRM_DOMAIN=crm.aria.aroice.in

# Where the backend thinks it lives. Rep join links and the Agora webhook URL
# are built from this, so it must be the public https address, not localhost.
PUBLIC_BASE_URL=https://aria.aroice.in

# The console is served from the same origin as the API (see deploy/Caddyfile),
# so there is no cross-origin request to allow. Kept explicit rather than
# blank because a wildcard here would be a real hole.
CORS_ALLOWED_ORIGINS=https://aria.aroice.in

# ------------------------------------------------------------------ secrets
# Generate each of these, do not invent them by hand:
#   openssl rand -base64 24
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# EspoCRM's admin login. This is on the public internet now, so it is NOT
# the local demo password - anyone who finds crm.<your domain> can try it.
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=

# Minted by scripts/provision_crm.py AFTER the stack is first up. Leave blank
# on the very first boot, then fill it in and restart the backend.
CRM_BACKEND=espocrm
ESPOCRM_API_KEY=
ESPOCRM_ASSIGNED_USER_ID=

# ------------------------------------------------------- model + voice keys
# Copied from your local backend/.env - same values, same names.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------- agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ------------------------------------------------------------------- email
# Optional. Off by default and a no-op when off.
EMAIL_ENABLED=false
SMTP_USERNAME=
SMTP_PASSWORD=
REP_SUMMARY_EMAIL=
HANDOFF_REP_EMAIL=

# ------------------------------------------------------------------- other
# Snapshots of CRM/calendar/inbox state. Path inside the container; the
# compose file mounts a named volume here so a redeploy keeps booked meetings.
STATE_DIR=/app/state
