# Secrets - never commit these. Real Agora / Anthropic / Groq / Voyage
# credentials live here; use backend/.env.example as the template.
.env
.env.*
!.env.example
!.env.local.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / Next.js
node_modules/
.next/
tsconfig.tsbuildinfo

# Runtime state: CRM/calendar/inbox snapshots and the local mem0 vector store.
# Regenerated from fixtures on first run.
backend/data/

# Local working notes - personal handover files, not part of the public repo
*.local.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Tunnel binary - ~70MB, and everyone needs their own platform's build.
# run.bat picks it up from here if it is not on PATH.
cloudflared.exe
cloudflared
