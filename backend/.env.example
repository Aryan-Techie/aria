# Agora Conversational AI Engine
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

# Public HTTPS base URL Agora will call back into (ngrok/tunnel URL in dev, deployed host on demo day)
PUBLIC_BASE_URL=https://your-tunnel-or-host.example.com

# Comma-separated list of origins the browser frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Primary reasoning LLM. Groq serves a tool-calling hop in well under a
# second where Anthropic takes ~4s, which decides whether a reply lands
# inside Agora's timeout window. Anthropic below is the automatic fallback:
# leave GROQ_API_KEY blank and everything runs on Anthropic alone.
# Note: Groq's free tier is ~6k tokens/minute and this agent's fixed cost is
# ~2.7k per hop, so expect fallback to Anthropic after a couple of hops.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
GROQ_TIMEOUT_SECONDS=6.0

# Fallback reasoning LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# mem0 session memory — uses ANTHROPIC_API_KEY (above) for its internal LLM
# calls and Voyage AI for embeddings (free tier: https://dash.voyageai.com).
# Memory is fully optional — the pipeline runs fine with no-op recall/write
# if this is left blank, it just won't have cross-turn long-range recall.
# Snapshot CRM/calendar/inbox to JSON so a backend restart mid-demo does not
# wipe a booked meeting. Leave blank for pure in-memory.
STATE_DIR=./data/state

MEM0_VECTOR_STORE_PATH=./data/mem0
VOYAGE_API_KEY=
# mem0 sends anonymous usage telemetry by default (not call content, but
# worth knowing) — set to False to opt out.
MEM0_TELEMETRY=True

# Escalation delivery
SLACK_WEBHOOK_URL=

# ASR/TTS vendor selection. Confirmed LIVE against the real Agora API:
# deepgram (ASR) + minimax (TTS) both work under managed mode — no external
# vendor account or API key needed for either. ("ares" under managed mode
# failed on this account's SKU; deepgram/minimax did not — the restriction
# was per-vendor, not a blanket ban on managed mode.)
ASR_VENDOR=deepgram
ASR_LANGUAGE=en
ASR_CREDENTIAL_MODE=managed
DEEPGRAM_MODEL=nova-3

TTS_VENDOR=minimax
TTS_CREDENTIAL_MODE=managed
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=English_captivating_female1

# Only used as a byok fallback if you switch ASR_CREDENTIAL_MODE/TTS_VENDOR
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Shared secret Agora echoes back as llm.api_key on every /chat/completions
# call. SET THIS: the webhook is exposed to the public internet through your
# tunnel, and it is the only thing between a stranger and your LLM bill.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_SHARED_SECRET=
