# Agora Conversational AI Engine
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

# Public HTTPS base URL Agora will call back into (ngrok/tunnel URL in dev, deployed host on demo day)
PUBLIC_BASE_URL=https://your-tunnel-or-host.example.com

# Comma-separated list of origins the browser frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Primary reasoning LLM. Groq serves a tool-calling hop in well under a
# second where Anthropic takes ~4s, which decides whether a reply lands
# inside Agora's timeout window. Anthropic below is the automatic fallback:
# leave GROQ_API_KEY blank and everything runs on Anthropic alone.
# Note: Groq's free tier is ~6k tokens/minute and this agent's fixed cost is
# ~2.7k per hop, so expect fallback to Anthropic after a couple of hops.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
GROQ_TIMEOUT_SECONDS=6.0

# Fallback reasoning LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# mem0 session memory — uses ANTHROPIC_API_KEY (above) for its internal LLM
# calls and Voyage AI for embeddings (free tier: https://dash.voyageai.com).
# Memory is fully optional — the pipeline runs fine with no-op recall/write
# if this is left blank, it just won't have cross-turn long-range recall.
# Snapshot CRM/calendar/inbox to JSON so a backend restart mid-demo does not
# wipe a booked meeting. Leave blank for pure in-memory.
STATE_DIR=./data/state

MEM0_VECTOR_STORE_PATH=./data/mem0
VOYAGE_API_KEY=
# mem0 sends anonymous usage telemetry by default (not call content, but
# worth knowing) — set to False to opt out.
MEM0_TELEMETRY=True

# Escalation delivery
# Confirmation email + calendar invite, sent to the customer when a meeting is
# booked (app/notify/). OFF by default: with EMAIL_ENABLED=false nothing is
# sent and nothing is attempted, so an unconfigured mail server cannot cost a
# live call anything.
#
# Gmail: turn on 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use that as SMTP_PASSWORD -
# the account password will be rejected. Free tier sends 500/day, which is
# several hundred more demos than anyone needs.
# Any other SMTP provider works too; set SMTP_PORT=465 for implicit TLS.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Blank falls back to SMTP_USERNAME. Most providers reject a From that is not
# the mailbox you authenticated as.
EMAIL_FROM=
EMAIL_FROM_NAME=Aria - Apple Business team
EMAIL_REPLY_TO=
# Optional silent copy of every confirmation, e.g. to the rep on the meeting.
EMAIL_BCC=
# Where the end-of-call wrap-up is emailed. Blank sends none - it still
# lands on the CRM record, which needs no configuration at all.
REP_SUMMARY_EMAIL=

SLACK_WEBHOOK_URL=

# ASR/TTS vendor selection. Confirmed LIVE against the real Agora API:
# deepgram (ASR) + minimax (TTS) both work under managed mode — no external
# vendor account or API key needed for either. ("ares" under managed mode
# failed on this account's SKU; deepgram/minimax did not — the restriction
# was per-vendor, not a blanket ban on managed mode.)
ASR_VENDOR=deepgram
ASR_LANGUAGE=en
ASR_CREDENTIAL_MODE=managed
DEEPGRAM_MODEL=nova-3

TTS_VENDOR=minimax
TTS_CREDENTIAL_MODE=managed
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=English_captivating_female1

# Only used as a byok fallback if you switch ASR_CREDENTIAL_MODE/TTS_VENDOR
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Shared secret Agora echoes back as llm.api_key on every /chat/completions
# call. SET THIS: the webhook is exposed to the public internet through your
# tunnel, and it is the only thing between a stranger and your LLM bill.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_SHARED_SECRET=

# ---------------------------------------------------------------------------
# CRM (EspoCRM) — see crm/docker-compose.yml and scripts/provision_crm.py
# ---------------------------------------------------------------------------
# "espocrm" talks to the real CRM; "memory" uses the in-process store.
# memory is also the automatic fallback when the key is blank or EspoCRM is
# unreachable — a backend that refuses to boot before a demo is worse than a
# backend running on fixtures.
CRM_BACKEND=memory
ESPOCRM_BASE_URL=http://localhost:8080
# Printed by scripts/provision_crm.py. EspoCRM returns the key ONLY in the
# response that creates the API user, so it cannot be read back later —
# re-run that script with --recreate if you lose it.
ESPOCRM_API_KEY=
# A Meeting requires an assignedUser and an api-type user cannot be one, so
# bookings hang off a regular user. Also printed by provision_crm.py.
ESPOCRM_ASSIGNED_USER_ID=

# Voice delivery (MiniMax t2a_v2 voice_setting). speed (0,2], vol (0,10],
# pitch [-12,12]; emotion is one of happy|sad|angry|fearful|disgusted|
# surprised|calm|fluent|whisper. "fluent" reads as conversational; "happy"
# oversells and sounds like a chirpy IVR on a sales call.
MINIMAX_SPEED=0.96
MINIMAX_VOL=1.0
MINIMAX_PITCH=0
MINIMAX_EMOTION=fluent
MINIMAX_ENGLISH_NORMALIZATION=True

# Agora's own stall phrases, triggered purely on webhook silence. OFF: every
# turn here is silent 0.9-2.6s because the pipeline buffers whole hops, which
# overlaps the 1.4s a tool hop takes, so it fired on 100% of turns. Bridge
# lines come from app/orchestrator/bridge_lines.py instead, which knows which
# tool actually fired.
FILLER_WORDS_ENABLED=False
FILLER_RESPONSE_WAIT_MS=800
